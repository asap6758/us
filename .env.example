# Shared passcode you both type once. Pick something only the two of you know.
APP_PASSCODE=change-me

# The two names, comma separated. First is "a", second is "b".
NAMES=Brandon,Priya

# Set automatically by Vercel when you add a Neon (Postgres) database from the Storage tab.
# Leave empty locally to use the file-based dev store in .data/
DATABASE_URL=

# Set automatically by Vercel when you add a Blob store from the Storage tab.
# Leave empty locally to keep photos in .data/uploads
BLOB_READ_WRITE_TOKEN=
